# ここにあるのは「公開してよい」設定の例です。
# 使うときはこのファイルをコピーして .env.local を作ってください (.env.local は Git に入りません)。
# VITE_ で始まる値はブラウザから誰でも見られます。パスワードや API キーは絶対に入れないでください。

# 画面右上に出る「公開した人」の名前 (例: tanaka)
VITE_APP_OWNER=tanaka

# 画面右上に出る環境ラベル: local / preview / production
VITE_APP_STAGE=local

# [L3 発展] API の接続先。空のままならモック(ダミーデータ)で動きます。設定するなら /api を推奨
VITE_API_BASE_URL=

# [L3 発展] GAS の Web アプリ URL。Vercel の環境変数にだけ設定し、ここには書かないでください
# GAS_WEB_APP_URL=
